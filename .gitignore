/_site/
/.quarto/
.DS_Store

**/*.quarto_ipynb
/test-results/

# Training corpora — binary shards, gigabytes, and re-cuttable from their manifest
# (trainer/corpus.js is deterministic given the corpus seed). The manifest itself
# IS committed; the shards are not.
/trainer/corpora/*
!/trainer/corpora/*.manifest.json
!/trainer/corpora/*.sample.jsonl
/trainer/node_modules/
# npm-linked playwright for the browser gates (parity.mjs, policy-bench.mjs) —
# a runtime ask, never a dependency.
/assets/pandas/engine/node_modules/

# Parity reference arrays — regenerable with trainer/py/reference.py, 128MB of frames.
# The committed contract is trainer/parity/parity-fixture.json. Deliberately OUTSIDE
# assets/: _quarto.yml lists assets/pandas/ as a site resource, so anything under it
# is swept into _site by a local render — 250MB of test fixtures on the public site.
/trainer/parity/*
!/trainer/parity/parity-fixture.json

# The Python training env and its run artefacts. The weights it exports ARE committed
# (assets/pandas/engine/policy/weights) — they are what the page fetches.
/trainer/py/.venv/
/trainer/py/runs/
/trainer/py/__pycache__/
/trainer/py/uv.lock
